{
  "$schema": "https://opencode.ai/v2/cli.json",
  "diffs": {
    "wrap": "word",
    "single": true
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "show",
    "permissions": "autoaccept",
    "verbosity": "high",
    "markdown": "rendered",
    "grouping": "auto",
    "tps": true
  },
  "animations": true,
  "theme": {
    "name": "system"
  },
  "scroll": {
    "acceleration": true
  },
  "prompt": {
    "paste": "compact",
    "image_preview": true
  },
  "terminal": {
    "copy": "select"
  }
}
