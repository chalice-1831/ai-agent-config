      "resource": "tmux *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "gh *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "gh --version",
      "effect": "allow"
    },
    {
      "action": "shell",
