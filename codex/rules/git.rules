# Git command policy.
prefix_rule(pattern = ["git", "status"], decision = "allow", match = ["git status --help"])
prefix_rule(pattern = ["git", "diff"], decision = "allow", match = ["git diff --help"])
prefix_rule(pattern = ["git", "grep"], decision = "allow", match = ["git grep --help"])
prefix_rule(pattern = ["git", "log"], decision = "allow", match = ["git log --help"])
prefix_rule(pattern = ["git", "show"], decision = "allow", match = ["git show --help"])
prefix_rule(pattern = ["git", "show-ref"], decision = "allow", match = ["git show-ref --help"])
prefix_rule(pattern = ["git", "rev-parse"], decision = "allow", match = ["git rev-parse --help"])
prefix_rule(pattern = ["git", "rev-list"], decision = "allow", match = ["git rev-list --help"])
prefix_rule(pattern = ["git", "merge-tree"], decision = "allow", match = ["git merge-tree --help"])
prefix_rule(pattern = ["git", "merge-base"], decision = "allow", match = ["git merge-base --help"])
prefix_rule(pattern = ["git", "ls-remote"], decision = "allow", match = ["git ls-remote --help"])
prefix_rule(pattern = ["git", "ls-files"], decision = "allow", match = ["git ls-files --help"])
prefix_rule(pattern = ["git", "for-each-ref"], decision = "allow", match = ["git for-each-ref --help"])
prefix_rule(pattern = ["git", "check-ignore"], decision = "allow", match = ["git check-ignore --help"])
prefix_rule(pattern = ["git", "blame"], decision = "allow", match = ["git blame --help"])
prefix_rule(pattern = ["git", "branch", "--show-current"], decision = "allow", match = ["git branch --show-current --help"])
prefix_rule(pattern = ["git", "branch", "--list"], decision = "allow", match = ["git branch --list --help"])
prefix_rule(pattern = ["git", "branch", "-r"], decision = "allow", match = ["git branch -r --help"])
prefix_rule(pattern = ["git", "fetch"], decision = "allow", match = ["git fetch --help"])
prefix_rule(pattern = ["git", "remote", "show"], decision = "allow", match = ["git remote show --help"])
prefix_rule(pattern = ["git", "remote", "get-url"], decision = "allow", match = ["git remote get-url --help"])
prefix_rule(pattern = ["git", "switch"], decision = "allow", match = ["git switch --help"])
prefix_rule(pattern = ["git", "stash"], decision = "allow", match = ["git stash --help"])
prefix_rule(pattern = ["git", "tag", "-l"], decision = "allow", match = ["git tag -l --help"])
prefix_rule(pattern = ["git", "tag", "--list"], decision = "allow", match = ["git tag --list --help"])
prefix_rule(pattern = ["git", "tag", "-v"], decision = "allow", match = ["git tag -v --help"])
prefix_rule(pattern = ["git", "tag", "--verify"], decision = "allow", match = ["git tag --verify --help"])
prefix_rule(pattern = ["git", "tag", "--short"], decision = "allow", match = ["git tag --short --help"])
prefix_rule(pattern = ["git", "path-id"], decision = "allow", match = ["git path-id --help"])
prefix_rule(pattern = ["git", "worktree"], decision = "allow", match = ["git worktree --help"])
prefix_rule(pattern = ["git", "push"], decision = "allow", match = ["git push --help"])
prefix_rule(pattern = ["git", "tag", "--sort"], decision = "allow", match = ["git tag --sort --help"])
prefix_rule(pattern = ["git", "describe"], decision = "allow", match = ["git describe --help"])
prefix_rule(pattern = ["git", "add"], decision = "allow", match = ["git add --help"])
prefix_rule(pattern = ["git", "commit"], decision = "allow", match = ["git commit --help"])
prefix_rule(pattern = ["git", "apply"], decision = "allow", match = ["git apply --help"])
prefix_rule(pattern = ["git", "checkout"], decision = "allow", match = ["git checkout --help"])
prefix_rule(pattern = ["git", "worktree", "add"], decision = "allow", match = ["git worktree add --help"])
prefix_rule(pattern = ["git", "push", "--force"], decision = "forbidden", justification = "Block destructive Git operations", match = ["git push --force example"])
prefix_rule(pattern = ["git", "push", "-f"], decision = "forbidden", justification = "Block destructive Git operations", match = ["git push -f example"])
prefix_rule(pattern = ["git", "push", "--force-with-lease"], decision = "forbidden", justification = "Block destructive Git operations", match = ["git push --force-with-lease example"])
prefix_rule(pattern = ["git", "push", "--mirror"], decision = "forbidden", justification = "Block destructive Git operations", match = ["git push --mirror example"])
prefix_rule(pattern = ["git", "push", "--delete"], decision = "forbidden", justification = "Block destructive Git operations", match = ["git push --delete example"])
prefix_rule(pattern = ["git", "push", "-d"], decision = "forbidden", justification = "Block destructive Git operations", match = ["git push -d example"])
prefix_rule(pattern = ["git", "push", "--all"], decision = "forbidden", justification = "Block destructive Git operations", match = ["git push --all example"])
prefix_rule(pattern = ["git", "push", "--tags"], decision = "forbidden", justification = "Block destructive Git operations", match = ["git push --tags example"])
prefix_rule(pattern = ["git", "stash", "drop"], decision = "forbidden", justification = "Block destructive Git operations", match = ["git stash drop example"])
prefix_rule(pattern = ["git", "stash", "clear"], decision = "forbidden", justification = "Block destructive Git operations", match = ["git stash clear example"])
prefix_rule(pattern = ["git", "branch", "-vv"], decision = "allow", match = ["git branch -vv", "git branch -vv --help"])
prefix_rule(pattern = ["git", "remote", "-v"], decision = "allow", match = ["git remote -v", "git remote -v --help"])
