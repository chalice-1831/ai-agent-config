# Copy this file to .env and fill host-specific values.
# Do not commit .env.

# Shared agentmemory endpoint for local agents.
AGENTMEMORY_URL=http://127.0.0.1:3111
AGENTMEMORY_SECRET=

# LLM provider. This stack uses OpenAI-compatible variables for the local gateway.
OPENAI_AUTH_TOKEN=
OPENAI_BASE_URL=http://127.0.0.1:8090/v1
AGENTMEMORY_MODEL=gpt-6-sol

# Embedding model for OpenAI-compatible embedding endpoints.
AGENTMEMORY_EMBEDDING_MODEL=Qwen3-Embedding-8B
AGENTMEMORY_EMBEDDING_DIMENSIONS=4096

# Optional native provider tokens.
ANTHROPIC_AUTH_TOKEN=
GEMINI_AUTH_TOKEN=
VOYAGE_API_KEY=

# Agentmemory features. Keep lowercase true/false.
AGENTMEMORY_AUTO_COMPRESS=false
AGENTMEMORY_GRAPH_EXTRACTION_ENABLED=false
AGENTMEMORY_INJECT_CONTEXT=false
AGENTMEMORY_EMBEDDING_PROVIDER=
