# 复制为 .env 后填写本机值，不要提交 .env。

# LLM provider。本 stack 默认使用 OpenAI-compatible 本地 gateway。
OPENAI_API_KEY=
OPENAI_BASE_URL=http://127.0.0.1:8090/v1
OPENAI_MODEL=gpt-6-sol

# Embedding provider。OpenAI-compatible embedding endpoint 使用 openai。
EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=Qwen3-Embedding-8B
OPENAI_EMBEDDING_DIMENSIONS=4096

# 可选 provider token。
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
VOYAGE_API_KEY=

# 常用 agentmemory 功能开关。true/false 保持小写。
AGENTMEMORY_AUTO_COMPRESS=false
GRAPH_EXTRACTION_ENABLED=false
AGENTMEMORY_INJECT_CONTEXT=false
RERANK_ENABLED=false
VIEWER_ALLOWED_HOSTS=localhost:3113,127.0.0.1:3113

# 搜索调优。保持注释时使用 agentmemory 上游默认值。
# BM25_WEIGHT=0.4
# VECTOR_WEIGHT=0.6
# AGENTMEMORY_GRAPH_WEIGHT=0.2
# TOKEN_BUDGET=2000
# MAX_OBS_PER_SESSION=500
# SUMMARIZE_CHUNK_SIZE=400
# SUMMARIZE_CHUNK_CONCURRENCY=6

# 高级行为开关。保持注释时使用 agentmemory 上游默认值。
# CONSOLIDATION_ENABLED=true
# CONSOLIDATION_DECAY_DAYS=30
# GRAPH_EXTRACTION_BATCH_SIZE=8
# AGENTMEMORY_LLM_NOTHINK=1
# AGENTMEMORY_REFLECT=true
# AGENTMEMORY_DROP_STALE_INDEX=true
# AGENTMEMORY_IMAGE_EMBEDDINGS=true

# 服务容器运行配置。除非这个 Compose stack 需要覆盖默认行为，否则保持注释。
# AGENTMEMORY_TOOLS=all
# AGENTMEMORY_DATA_DIR=/data
# AGENTMEMORY_EXPORT_ROOT=
# AGENTMEMORY_VIEWER_URL=http://127.0.0.1:3113
# SNAPSHOT_ENABLED=true
# SNAPSHOT_DIR=/data/snapshots
# SNAPSHOT_INTERVAL=3600
# TEAM_MODE=shared
# TEAM_ID=
# USER_ID=
