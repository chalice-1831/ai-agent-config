{
  "$schema": "https://opencode.ai/config.json",
  "compaction": {
    "auto": true
  },
   "experimental": {
    "todo": true
  },
  "mcp": {
    "servers": {
      "codegraph": {
        "type": "local",
        "disabled": false,
        "command": [
          "codegraph",
          "serve",
          "--mcp"
        ]
      },
      "sequential-thinking": {
        "type": "local",
        "disabled": false,
        "command": [
          "npx",
          "-y",
          "@modelcontextprotocol/server-sequential-thinking"
        ]
      },
      "exa": {
        "type": "local",
        "disabled": false,
        "command": [
          "npx",
          "-y",
          "exa-mcp-server"
        ]
      },
      "context7": {
        "type": "local",
        "disabled": false,
        "command": [
          "npx",
          "-y",
          "@upstash/context7-mcp"
        ]
      },
      "deepwiki": {
        "type": "remote",
        "disabled": false,
        "url": "https://mcp.deepwiki.com/mcp"
      },
      "gh_grep": {
        "type": "remote",
        "disabled": false,
        "url": "https://mcp.grep.app"
      },
      "mise": {
        "type": "local",
        "disabled": false,
        "command": [
          "mise",
          "mcp"
        ],
        "environment": {
          "MISE_EXPERIMENTAL": "1"
        }
      },
      "agentmemory": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@agentmemory/mcp"
        ],
        "disabled": false,
        "environment": {
          "AGENTMEMORY_URL": "{env:AGENTMEMORY_URL}",
          "AGENTMEMORY_SECRET": "{env:AGENTMEMORY_SECRET}"
        }
      }
    }
  },
  "plugins": [],
  "share": "disabled",
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      ".git/**",
      "*.log"
    ]
  },
  "agents": {
    "title": {
      "model": {
        "providerID": "openai",
        "model": "luna-6",
        "variant": "high"
      }
    },
    "plan": {
      "model": {
        "providerID": "openai",
        "model": "sol-6.1",
        "variant": "high"
      }
    },
    "build": {
      "model": {
        "providerID": "openai",
        "model": "sol-6.1",
        "variant": "high"
      }
    },
    "explore": {
      "model": {
        "providerID": "openai",
        "model": "luna-6",
        "variant": "high"
      }
    }
  },
  "model": "openai/sol-6.1",
  "update": "notify",
  "formatter": {
    "gofmt": {
      "command": [
        "gofmt",
        "-w",
        "$FILE"
      ],
      "extensions": [
        ".go"
      ]
    },
    "shfmt": {
      "command": [
        "shfmt",
        "-w",
        "$FILE"
      ],
      "extensions": [
        ".sh",
        ".bash"
      ]
    },
    "prettier": {
      "command": [
        "npx",
        "prettier",
        "--write",
        "$FILE"
      ],
      "extensions": [
        ".md"
      ]
    }
  },
  "providers": {
    "anthropic": {
      "name": "anthropic",
      "package": "@opencode/ai/providers/anthropic",
      "settings": {
        "baseURL": "{env:ANTHROPIC_BASE_URL}/v1",
        "apiKey": "{env:ANTHROPIC_AUTH_TOKEN}",
        "disableMaxOutputTokens": true
      },
      "models": {
        "opus-5-5": {
          "limit": {
            "context": 200000,
            "output": 128000
          },
          "modelID": "opus-5-5",
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ],
            "reasoning": {
              "supported": true
            }
          },
          "settings": {
            "thinking": {
              "type": "enabled",
              "budgetTokens": 16000
            }
          },
          "variants": [
            {
              "id": "low",
              "settings": {
                "effort": "low"
              }
            },
            {
              "id": "medium",
              "settings": {
                "effort": "high"
              }
            },
            {
              "id": "high",
              "settings": {
                "thinking": {
                  "type": "enabled",
                  "budgetTokens": 32000
                }
              }
            },
            {
              "id": "xhigh",
              "settings": {
                "thinking": {
                  "type": "enabled",
                  "budgetTokens": 128000
                },
                "speed": "fast"
              }
            }
          ]
        },
        "sonnet-5-5": {
          "limit": {
            "context": 200000,
            "output": 128000
          },
          "modelID": "sonnet-5-5",
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ],
            "reasoning": {
              "supported": true
            }
          },
          "settings": {
            "thinking": {
              "type": "enabled",
              "budgetTokens": 16000
            }
          },
          "variants": [
            {
              "id": "low",
              "settings": {
                "effort": "low"
              }
            },
            {
              "id": "medium",
              "settings": {
                "effort": "high"
              }
            },
            {
              "id": "high",
              "settings": {
                "thinking": {
                  "type": "enabled",
                  "budgetTokens": 32000
                }
              }
            },
            {
              "id": "xhigh",
              "settings": {
                "thinking": {
                  "type": "enabled",
                  "budgetTokens": 128000
                },
                "speed": "fast"
              }
            }
          ]
        },
        "haiku-5-5": {
          "limit": {
            "context": 200000,
            "output": 128000
          },
          "modelID": "haiku-5-5",
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ],
            "reasoning": {
              "supported": true
            }
          },
          "settings": {
            "thinking": {
              "type": "enabled",
              "budgetTokens": 16000
            }
          },
          "variants": [
            {
              "id": "low",
              "settings": {
                "effort": "low"
              }
            },
            {
              "id": "medium",
              "settings": {
                "effort": "high"
              }
            },
            {
              "id": "high",
              "settings": {
                "thinking": {
                  "type": "enabled",
                  "budgetTokens": 32000
                }
              }
            },
            {
              "id": "xhigh",
              "settings": {
                "thinking": {
                  "type": "enabled",
                  "budgetTokens": 128000
                },
                "speed": "fast"
              }
            }
          ]
        }
      },
      "compatibility": {
        "supportsPromptCacheKey": true
      }
    },
    "openai": {
      "name": "openai",
      "package": "@opencode/ai/providers/openai/responses",
      "settings": {
        "baseURL": "{env:OPENAI_BASE_URL}",
        "apiKey": "{env:OPENAI_AUTH_TOKEN}",
        "transport": "websocket",
        "disableMaxOutputTokens": true,
        "headerTimeout": 60000,
        "timeout": 600000,
        "chunkTimeout": 60000
      },
      "models": {
        "astra-6": {
          "limit": {
            "context": 200000,
            "output": 128000
          },
          "modelID": "astra-6",
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ],
            "reasoning": {
              "supported": true
            }
          },
          "compatibility": {
            "reasoningField": "reasoning_content"
          },
          "variants": [
            {
              "id": "high",
              "settings": {
                "reasoningEffort": "high",
                "reasoningSummary": "auto",
                "textVerbosity": "medium"
              }
            },
            {
              "id": "low",
              "settings": {
                "reasoningEffort": "low",
                "reasoningSummary": "auto",
                "textVerbosity": "medium"
              }
            },
            {
              "id": "medium",
              "settings": {
                "reasoningEffort": "medium",
                "reasoningSummary": "auto",
                "textVerbosity": "medium"
              }
            },
            {
              "id": "xhigh",
              "settings": {
                "reasoningEffort": "xhigh",
                "reasoningSummary": "auto",
                "textVerbosity": "medium"
              }
            }
          ]
        },
        "sol-6.1": {
          "limit": {
            "context": 272000,
            "output": 128000
          },
          "cost": {
            "input": 5,
            "output": 30,
            "cache": {
              "read": 0.5
            }
          },
          "modelID": "sol-6.1",
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ],
            "reasoning": {
              "supported": true
            }
          },
          "compatibility": {
            "reasoningField": "reasoning_content"
          },
          "variants": [
            {
              "id": "high",
              "settings": {
                "reasoningEffort": "high",
                "reasoningSummary": "auto",
                "textVerbosity": "medium"
              }
            },
            {
              "id": "low",
              "settings": {
                "reasoningEffort": "low",
                "reasoningSummary": "auto",
                "textVerbosity": "medium"
              }
            },
            {
              "id": "medium",
              "settings": {
                "reasoningEffort": "medium",
                "reasoningSummary": "auto",
                "textVerbosity": "medium"
              }
            },
            {
              "id": "xhigh",
              "settings": {
                "reasoningEffort": "xhigh",
                "reasoningSummary": "auto",
                "textVerbosity": "medium"
              }
            }
          ]
        },
        "luna-6": {
          "limit": {
            "context": 200000,
            "output": 128000
          },
          "modelID": "luna-6",
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ],
            "reasoning": {
              "supported": true
            }
          },
          "compatibility": {
            "reasoningField": "reasoning_content"
          },
          "variants": [
            {
              "id": "high",
              "settings": {
                "reasoningEffort": "high",
                "reasoningSummary": "auto",
                "textVerbosity": "medium"
              }
            },
            {
              "id": "low",
              "settings": {
                "reasoningEffort": "low",
                "reasoningSummary": "auto",
                "textVerbosity": "medium"
              }
            },
            {
              "id": "medium",
              "settings": {
                "reasoningEffort": "medium",
                "reasoningSummary": "auto",
                "textVerbosity": "medium"
              }
            },
            {
              "id": "xhigh",
              "settings": {
                "reasoningEffort": "xhigh",
                "reasoningSummary": "auto",
                "textVerbosity": "medium"
              }
            }
          ]
        }
      }
    }
  },
  "policies": [
    {
      "action": "provider.use",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "provider.use",
      "resource": "openai",
      "effect": "allow"
    },
    {
      "action": "provider.use",
      "resource": "anthropic",
      "effect": "allow"
    }
  ],
  "shell": "/bin/zsh",
  "permissions": [
    {
      "action": "shell",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "pwd",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "defuddle *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "data *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "printf *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "sleep *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "ls *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "find *",
      "effect": "allow"
    },
    {
      "action": "shell",
