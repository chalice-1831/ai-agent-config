{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "opencode-go": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "opencode-go",
      "options": {
        "baseURL": "{env:AXONHUB_BASE_URL}",
        "apiKey": "{env:AXONHUB_AUTH_TOKEN}",
        "disableMaxOutputTokens": true,
        "setCacheKey": true
      },
      "whitelist": [
        "minimax-m3",
        "deepseek-v4-flash",
        "qwen3.7-max",
        "kimi-k2.7-code",
        "mimo-v2.5"
      ],
      "models": {
        "minimax-m3": {
          "name": "minimax-m3"
        },
        "deepseek-v4-flash": {
          "name": "deepseek-v4-flash"
        },
        "qwen3.7-max": {
          "name": "qwen3.7-max"
        },
        "kimi-k2.7-code": {
          "name": "kimi-k2.7-code"
        },
        "mimo-v2.5": {
          "name": "mimo-v2.5"
        }
      }
    },
    "openai": {
      "name": "openai",
      "npm": "@ai-sdk/openai",
      "api": "responses",
      "options": {
        "baseURL": "{env:AXONHUB_BASE_URL}",
        "apiKey": "{env:AXONHUB_AUTH_TOKEN}",
        "disableMaxOutputTokens": true,
        "truncation": "auto",
        "headerTimeout": 60000,
        "timeout": 600000,
        "chunkTimeout": 60000
      },
      "whitelist": [
        "gpt-5.5",
        "gpt-5.6-sol",
        "gpt-5.6-terra",
        "gpt-5.6-luna",
        "gpt-6-astra"
      ],
      "models": {
        "gpt-5.5": {
          "limit": {
            "context": 200000,
            "output": 128000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "name": "gpt-5.5",
          "interleaved": {
            "field": "reasoning_content"
          },
          "variants": {
            "high": {
              "reasoningEffort": "high",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            },
            "low": {
              "reasoningEffort": "low",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            },
            "medium": {
              "reasoningEffort": "medium",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            },
            "xhigh": {
              "reasoningEffort": "xhigh",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            }
          }
        },
        "gpt-5.6-sol": {
          "limit": {
            "context": 272000,
            "output": 128000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "name": "gpt-5.6-sol",
          "interleaved": {
            "field": "reasoning_content"
          },
          "cost": {
            "input": 5,
            "output": 30,
            "cache_read": 0.5
          },
          "reasoning": true,
          "tool_call": true,
          "variants": {
            "high": {
              "reasoningEffort": "high",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            },
            "low": {
              "reasoningEffort": "low",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            },
            "medium": {
              "reasoningEffort": "medium",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            },
            "xhigh": {
              "reasoningEffort": "xhigh",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            }
          }
        },
        "gpt-5.6-terra": {
          "limit": {
            "context": 272000,
            "output": 128000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "name": "gpt-5.6-terra",
          "interleaved": {
            "field": "reasoning_content"
          },
          "cost": {
            "input": 2.5,
            "output": 15,
            "cache_read": 0.25
          },
          "reasoning": true,
          "tool_call": true,
          "variants": {
            "high": {
              "reasoningEffort": "high",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            },
            "low": {
              "reasoningEffort": "low",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            },
            "medium": {
              "reasoningEffort": "medium",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            },
            "xhigh": {
              "reasoningEffort": "xhigh",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            }
          }
        },
        "gpt-5.6-luna": {
          "limit": {
            "context": 272000,
            "output": 128000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "name": "gpt-5.6-luna",
          "interleaved": {
            "field": "reasoning_content"
          },
          "cost": {
            "input": 1,
            "output": 6,
            "cache_read": 0.1
          },
          "reasoning": true,
          "tool_call": true,
          "variants": {
            "high": {
              "reasoningEffort": "high",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            },
            "low": {
              "reasoningEffort": "low",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            },
            "medium": {
              "reasoningEffort": "medium",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            },
            "xhigh": {
              "reasoningEffort": "xhigh",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            }
          }
        },
        "gpt-6-astra": {
            "limit": {
                "context": 272000,
                "output": 128000
            },
            "modalities": {
                "input": [
                    "text",
                    "image"
                ],
                "output": [
                    "text"
                ]
            },
            "name": "gpt-6-astra",
            "interleaved": {
                "field": "reasoning_content"
            },
            "cost": {
                "input": 10,
                "output": 50,
                "cache_read": 1
            },
            "reasoning": true,
            "tool_call": true,
            "variants": {
                "low": {
                    "reasoningEffort": "low",
                    "reasoningSummary": "auto",
                    "textVerbosity": "medium"
                },
                "medium": {
                    "reasoningEffort": "medium",
                    "reasoningSummary": "auto",
                    "textVerbosity": "medium"
                },
                "high": {
                    "reasoningEffort": "high",
                    "reasoningSummary": "auto",
                    "textVerbosity": "medium"
                },
                "xhigh": {
                    "reasoningEffort": "xhigh",
                    "reasoningSummary": "auto",
                    "textVerbosity": "medium"
                },
                "max": {
                    "reasoningEffort": "max",
                    "reasoningSummary": "auto",
                    "textVerbosity": "medium"
                }
            }
        }
      }
    }
  },
  "compaction": {
    "auto": false,
    "prune": false
  },
  "mcp": {
    "serena": {
      "type": "local",
      "enabled": true,
      "command": [
        "serena",
        "start-mcp-server",
        "--context",
        "ide",
        "--open-web-dashboard",
        "false",
        "--project-from-cwd"
      ]
    },
    "sequential-thinking": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },
    "exa": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "exa-mcp-server"
      ]
    },
    "context7": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ]
    },
    "memory": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-memory"
      ]
    },
    "deepwiki": {
      "type": "remote",
      "enabled": true,
      "url": "https://mcp.deepwiki.com/mcp"
    },
    "gh_grep": {
      "type": "remote",
      "enabled": true,
      "url": "https://mcp.grep.app"
    }
  },
  "plugin": [
    "opencode-axonhub-tracing@1.1.0",
    //    "@snubisks/opencode-dcp@3.1.14",
    //    "@tarquinen/opencode-dcp@3.1.15",
//    "oh-my-openagent@v4.19.2",
    "opencode-acp@stable"
  ],
  "share": "disabled",
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      ".git/**",
      "*.log"
    ]
  },
  "agent": {
    "plan": {
      "model": "openai/gpt-5.5"
    },
    "build": {
      "model": "openai/gpt-5.5"
    }
  },
  "autoupdate": "notify",
  "logLevel": "INFO",
  "enabled_providers": [
    "openai",
    "opencode-go"
  ],
  "username": "chalice-1831",
  "small_model": "openai/gpt-5.6-luna",
  "permission": {
    // Baseline: unknown capabilities ask by default. Specific safe tools are allowed below.
    "bash": {
      "*": "ask",
      // Local read-only inspection and verification.
      "pwd": "allow",
      "sleep *": "ask",
      "ls *": "allow",
      "find *": "allow",
      "rg *": "allow",
      "grep *": "allow",
      "sed *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "less": "allow",
      "which": "allow",
      "wc *": "allow",
      "sort *": "allow",
      "diff *": "allow",
      "jq *": "allow",
      "yq *": "allow",
      "echo *": "allow",
      "curl *": "allow",
      "go *": "allow",
      "gofmt *": "allow",
      "pnpm run *": "allow",
      "npm list *": "allow",
      "pip list *": "allow",
      "python *": "allow",
      "dpkg *": "allow",
      "php *": "allow",
      "tmux": "allow",
      "tmux *": "allow",
      // GitHub CLI defaults to ask; read-only discovery is allowed, credential and destructive paths are denied later.
      "gh *": "ask",
      "gh --version": "allow",
      "gh -h": "allow",
      "gh --help": "allow",
      "gh help": "allow",
      "gh help *": "allow",
      "gh status": "allow",
      "gh status *": "allow",
      // Auth status is allowed only without token-printing flags.
      "gh auth status": "allow",
      "gh auth status --json hosts": "allow",
      // Common read-only GitHub CLI commands.
      "gh search code *": "allow",
      "gh search commits *": "allow",
      "gh search issues *": "allow",
      "gh search prs *": "allow",
      "gh search repos *": "allow",
      "gh repo view": "allow",
      "gh repo view *": "allow",
      "gh repo list": "allow",
      "gh repo list *": "allow",
      "gh repo ls": "allow",
      "gh repo ls *": "allow",
      "gh repo gitignore list": "allow",
      "gh repo gitignore list *": "allow",
      "gh repo gitignore view *": "allow",
      "gh repo license list": "allow",
      "gh repo license list *": "allow",
      "gh repo license view *": "allow",
      "gh repo autolink list": "allow",
      "gh repo autolink list *": "allow",
      "gh repo autolink view *": "allow",
      "gh repo deploy-key list": "allow",
      "gh repo deploy-key list *": "allow",
      "gh repo read-dir *": "allow",
      "gh pr view *": "allow",
      "gh pr list": "allow",
      "gh pr list *": "allow",
      "gh pr ls": "allow",
      "gh pr ls *": "allow",
      "gh pr diff *": "allow",
      "gh pr status": "allow",
      "gh pr status *": "allow",
      "gh pr checks *": "allow",
      "gh issue create *": "allow",
      "gh issue edit *": "allow",
      "gh issue view *": "allow",
      "gh issue list": "allow",
      "gh issue list *": "allow",
      "gh issue status": "allow",
      "gh issue status *": "allow",
      "gh issue comment *": "allow",
      "gh discussion view *": "allow",
      "gh discussion list": "allow",
      "gh discussion list *": "allow",
      "gh release view *": "allow",
      "gh release list": "allow",
      "gh release list *": "allow",
      "gh release ls": "allow",
      "gh release ls *": "allow",
      "gh release verify *": "allow",
      "gh release verify-asset *": "allow",
      "gh run view *": "allow",
      "gh run list": "allow",
      "gh run list *": "allow",
      "gh run ls": "allow",
      "gh run ls *": "allow",
      "gh workflow view *": "allow",
      "gh workflow list": "allow",
      "gh workflow list *": "allow",
      "gh workflow ls": "allow",
      "gh workflow ls *": "allow",
      "gh label list": "allow",
      "gh label list *": "allow",
      "gh alias list": "allow",
      "gh alias list *": "allow",
      "gh skill list": "allow",
      "gh skill list *": "allow",
      "gh skill search *": "allow",
      "gh skill preview *": "allow",
      "gh project list": "allow",
      "gh project list *": "allow",
      "gh project view *": "allow",
      "gh project field-list *": "allow",
      "gh project item-list *": "allow",
      "gh org list": "allow",
      "gh org list *": "allow",
      "gh ruleset check *": "allow",
      "gh ruleset list": "allow",
      "gh ruleset list *": "allow",
      "gh ruleset view *": "allow",
      "gh cache list": "allow",
      "gh cache list *": "allow",
      "gh agent-task list": "allow",
      "gh agent-task list *": "allow",
      "gh agent-task view *": "allow",
      "gh gist list": "allow",
      "gh gist list *": "allow",
      "gh ssh-key list": "allow",
      "gh gpg-key list": "allow",
      "gh variable list": "allow",
      "gh variable list *": "allow",
      // gh api comment reads: GET-like comment endpoints plus local output formatting only.
      "gh api repos/*/*/comments": "allow",
      "gh api /repos/*/*/comments": "allow",
      "gh api repos/*/*/comments -q *": "allow",
      "gh api repos/*/*/comments --jq *": "allow",
      "gh api repos/*/*/comments -t *": "allow",
      "gh api repos/*/*/comments --template *": "allow",
      "gh api /repos/*/*/comments -q *": "allow",
      "gh api /repos/*/*/comments --jq *": "allow",
      "gh api /repos/*/*/comments -t *": "allow",
      "gh api /repos/*/*/comments --template *": "allow",
      "gh api repos/*/*/comments/*": "allow",
      "gh api /repos/*/*/comments/*": "allow",
      "gh api repos/*/*/comments/* *": "ask",
      "gh api /repos/*/*/comments/* *": "ask",
      "gh api repos/*/*/comments/* -q *": "allow",
      "gh api repos/*/*/comments/* --jq *": "allow",
      "gh api repos/*/*/comments/* -t *": "allow",
      "gh api repos/*/*/comments/* --template *": "allow",
      "gh api /repos/*/*/comments/* -q *": "allow",
      "gh api /repos/*/*/comments/* --jq *": "allow",
      "gh api /repos/*/*/comments/* -t *": "allow",
      "gh api /repos/*/*/comments/* --template *": "allow",
      "gh api /repos/*/*/pull/files *": "allow",
      "gh api repos/*/*/issues/*/timeline *": "allow",
      // Keep request-body/method controls behind ask even after a comments read allow.
      "gh api * -f *": "ask",
      "gh api * -f=*": "ask",
      "gh api * --raw-field *": "ask",
      "gh api * --raw-field=*": "ask",
      "gh api * -F *": "ask",
      "gh api * -F=*": "ask",
      "gh api * --field *": "ask",
      "gh api * --field=*": "ask",
      "gh api * --input *": "ask",
      "gh api * --input=*": "ask",
      "gh api * -X *": "ask",
      "gh api * -X=*": "ask",
      "gh api * --method *": "ask",
      "gh api * --method=*": "ask",
      "gh auth token": "deny",
      "gh auth token *": "deny",
      "gh auth status --show-token": "deny",
      "gh auth status --show-token *": "deny",
      "gh auth status * --show-token": "deny",
      "gh auth status * --show-token *": "deny",
      "gh auth status -t": "deny",
      "gh auth status -t *": "deny",
      "gh auth status * -t": "deny",
      "gh auth status * -t *": "deny",
      "gh auth logout": "deny",
      "gh auth logout *": "deny",
      "gh repo delete": "deny",
      "gh repo delete *": "deny",
      "gh repo archive": "deny",
      "gh repo archive *": "deny",
      "gh repo deploy-key delete": "deny",
      "gh repo deploy-key delete *": "deny",
      "gh issue delete": "deny",
      "gh issue delete *": "deny",
      "gh release delete": "deny",
      "gh release delete *": "deny",
      "gh release delete-asset": "deny",
      "gh release delete-asset *": "deny",
      "gh run delete": "deny",
      "gh run delete *": "deny",
      "gh project delete": "deny",
      "gh project delete *": "deny",
      "gh project field-delete": "deny",
      "gh project field-delete *": "deny",
      "gh project item-delete": "deny",
      "gh project item-delete *": "deny",
      "gh ssh-key delete": "deny",
      "gh ssh-key delete *": "deny",
      "gh gpg-key delete": "deny",
      "gh gpg-key delete *": "deny",
      "gh secret delete": "deny",
      "gh secret delete *": "deny",
      "gh gist delete": "deny",
      "gh gist delete *": "deny",
      "gh cache delete": "deny",
      "gh cache delete *": "deny",
      "gh codespace delete": "deny",
      "gh codespace delete *": "deny",
      "kubectl get *": "allow",
      "kubectl describe *": "allow",
      "kubectl logs *": "allow",
      "docker ps *": "allow",
      "docker logs *": "allow",
      "docker images *": "allow",
      "docker manifest inspect *": "allow",
      "docker build *": "allow",
      // Git defaults to ask; read-only discovery is allowed, destructive force/delete paths are denied later.
      "git *": "ask",
      "git status *": "allow",
      "git diff *": "allow",
      "git grep *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git show-ref *": "allow",
      "git rev-parse *": "allow",
      "git rev-list *": "allow",
      "git merge-tree *": "allow",
      "git merge-base *": "allow",
      "git ls-remote *": "allow",
      "git ls-files *": "allow",
      "git for-each-ref *": "allow",
      "git check-ignore *": "allow",
      "git blame *": "allow",
      "git branch -vv": "allow",
      "git branch --show-current": "allow",
      "git branch --show-current *": "allow",
      "git branch --list": "allow",
      "git branch --list *": "allow",
      "git branch -r *": "allow",
      "git fetch *": "allow",
      "git remote -v": "allow",
      "git remote show *": "allow",
      "git remote get-url *": "allow",
      "git switch *": "allow",
      "git stash *": "allow",
      "git tag -l *": "allow",
      "git tag --list *": "allow",
      "git tag -v *": "allow",
      "git tag --verify *": "allow",
      "git tag --short *": "allow",
      "git path-id *": "allow",
      "git worktree *": "allow",
      "git push *": "allow",
      "git push --force *": "deny",
      "git push -f *": "deny",
      "git push --force-with-lease *": "deny",
      "git push --mirror *": "deny",
      "git push --delete *": "deny",
      "git push -d *": "deny",
      "git push --all *": "deny",
      "git push --tags": "deny",
      "git push --tags *": "deny",
      "git reset --hard": "deny",
      "git reset --hard *": "deny",
      "git clean -fdx *": "deny",
      "git clean -fxd *": "deny",
      "git clean -dfx *": "deny",
      "git branch -D *": "deny",
      "git tag --sort *": "allow",
      "git describe *": "allow",
      "git tag -d *": "deny",
      "git tag --delete *": "deny",
      "git tag -f *": "deny",
      "git tag --force *": "deny",
      "git stash drop *": "deny",
      "git stash clear *": "deny",
      "git filter-branch *": "deny",
      "git prune *": "deny",
      "git credential *": "deny",
      "git credential-cache *": "deny",
      "git credential-store *": "deny",
      "git update-ref *": "deny",
      "git symbolic-ref *": "deny",
      "git update-index *": "deny",
      "git read-tree *": "deny",
      // In addition to the read‑only Git commands mentioned above, the following commands are also allowed.
      "git add *": "allow",
      "git commit *": "allow",
      "git apply *": "allow",
      "git checkout *": "allow",
      "git worktree add *": "allow",
      "base64 -d": "allow",
      "nl -ba": "allow",
      "xargs *": "allow",
      // opencode related commands.
      "opencode --version": "allow",
      "opencode models": "allow",
      // Commands that can change files, dependencies, infrastructure, or external state.
      "cp *": "ask",
      "mv *": "ask",
      "mkdir *": "ask",
      "tee *": "ask",
      "npx *": "ask",
      "bunx *": "ask",
      "npm install *": "ask",
      "npm uninstall *": "ask",
      "npm publish *": "deny",
      "npm link *": "ask",
      "pnpm add *": "ask",
      "pnpm remove *": "ask",
      "pip install *": "ask",
      "pip uninstall *": "ask",
      "docker run *": "ask",
      "docker exec *": "ask",
      "docker rm *": "ask",
      "docker rmi *": "ask",
      "docker stop *": "ask",
      "docker kill *": "ask",
      "docker volume rm *": "ask",
      "docker network rm *": "ask",
      "kubectl apply *": "ask",
      "kubectl delete *": "ask",
      "kubectl exec *": "ask",
      "kubectl edit *": "ask",
      "kubectl patch *": "ask",
      "kubectl scale *": "ask",
      "kubectl cordon *": "ask",
      "helm *": "ask",
      "helm lint *": "allow",
      "helm version *": "allow",
      "helm template *": "allow",
      "helm dependency build *": "allow",
      "rm -r *": "ask",
      "rm *": "ask",
      "rmdir *": "ask",
      "chmod *": "ask",
      "chown *": "ask",
      "sudo *": "ask",
      "sudo chmod *": "ask",
      "sudo chown *": "ask",
      "sudo systemctl *": "ask",
      "sudo apt *": "ask",
      // Destructive or privilege-sensitive commands stay denied even if broader ask rules match earlier.
      "git clean -fd *": "ask",
      "docker system prune *": "deny",
      "kubectl drain *": "deny",
      "rm -rf *": "deny",
      "sudo rm *": "deny",
      "ansible-playbook": "ask",
      "ansible-playbook --syntax-check *": "allow",
      "mise *": "ask",
      "mise ls *": "allow",
      "test *": "allow",
      "awk *": "allow",
      "true": "allow",
      "command -v *": "allow",
      "golangci-lint *": "allow",
      // gcx: Grafana Cloud CLI. Unknown and mutating operations ask by default.
      "gcx *": "ask",
      // Read-only discovery and local context checks.
      "gcx --help": "allow",
      "gcx help *": "allow",
      "gcx help-tree *": "allow",
      "gcx commands *": "allow",
      "gcx version": "allow",
      "gcx version *": "allow",
      "gcx providers list *": "allow",
      "gcx config check": "allow",
      "gcx config current-context": "allow",
      "gcx config list-contexts *": "allow",
      "gcx config path *": "allow",
      "gcx config view": "allow",
      "gcx config view -o json": "allow",
      "gcx config view -o yaml": "allow",
      // Resource and telemetry read-only operations.
      "gcx resources get *": "allow",
      "gcx resources list-types *": "allow",
      "gcx resources list-examples *": "allow",
      "gcx resources validate *": "allow",
      "gcx dashboards list *": "allow",
      "gcx dashboards search *": "allow",
      "gcx dashboards get *": "allow",
      "gcx dashboards list-versions *": "allow",
      "gcx datasources list *": "allow",
      "gcx datasources get *": "allow",
      "gcx datasources health *": "allow",
      "gcx datasources schemas *": "allow",
      "gcx metrics labels *": "allow",
      "gcx metrics metadata *": "allow",
      "gcx metrics series *": "allow",
      "gcx metrics query *": "allow",
      "gcx logs labels *": "allow",
      "gcx logs series *": "allow",
      "gcx logs query *": "allow",
      "gcx logs metrics *": "allow",
      "gcx traces labels *": "allow",
      "gcx traces query *": "allow",
      "gcx traces get *": "allow",
      "gcx traces metrics *": "allow",
      "gcx profiles labels *": "allow",
      "gcx profiles list-profile-types *": "allow",
      "gcx profiles query *": "allow",
      "gcx profiles metrics *": "allow",
      "gcx profiles exemplars *": "allow",
      // Credential, raw secret, and destructive operations stay denied.
      "gcx login *": "deny",
      "gcx cloud login *": "deny",
      "gcx config view *--raw*": "deny",
      "gcx config set *": "deny",
      "gcx config unset *": "deny",
      "gcx config edit *": "deny",
      "gcx * delete *": "deny",
      "gcx cloud stacks delete *": "deny",
      "gcx resources delete *": "deny",
      "gcx dashboards delete *": "deny",
      "gcx alert notification-policies reset *": "deny",
      "gcx agent prune *": "deny"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.key": "deny",
      "*.pem": "deny",
      "*.p12": "deny",
      "*.pfx": "deny",
      "*.secret": "deny",
      "*secret*": "deny",
      "*token*": "deny",
      "*credential*": "deny",
      "*password*": "deny",
      "*id_rsa*": "deny",
      "*id_ed25519*": "deny",
      "*kubeconfig*": "deny",
      ".git/config": "deny",
      "credentials/**": "deny",
      "*/credentials/**": "deny",
      "*/.ssh/**": "deny",
      "*/.gnupg/**": "deny",
      "*/secrets/**": "deny"
    },
    "glob": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.key": "deny",
      "*.pem": "deny",
      "*.p12": "deny",
      "*.pfx": "deny",
      "*.secret": "deny",
      "*secret*": "deny",
      "*token*": "deny",
      "*credential*": "deny",
      "*password*": "deny",
      "credentials/**": "deny",
      "*/credentials/**": "deny",
      "*/.ssh/**": "deny",
      "*/.gnupg/**": "deny",
      "*/secrets/**": "deny"
    },
    "grep": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.key": "deny",
      "*.pem": "deny",
      "*.p12": "deny",
      "*.pfx": "deny",
      "*.secret": "deny",
      "*secret*": "deny",
      "*token*": "deny",
      "*credential*": "deny",
      "*password*": "deny",
      "credentials/**": "deny",
      "*/credentials/**": "deny",
      "*/.ssh/**": "deny",
      "*/.gnupg/**": "deny",
      "*/secrets/**": "deny"
    },
    "edit": {
      "*": "ask",
      "opencode/**": "allow",
      "AGENTS.md": "allow",
      "~/.config/opencode/**": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.key": "deny",
      "*.pem": "deny",
      "*.p12": "deny",
      "*.pfx": "deny",
      "*.secret": "deny",
      "*secret*": "deny",
      "*token*": "deny",
      "*credential*": "deny",
      "*password*": "deny",
      "credentials/**": "deny",
      "*/credentials/**": "deny",
      "*/.ssh/**": "deny",
      "*/secrets/**": "deny"
    },
    "write": {
      "*": "ask",
      "opencode/**": "allow",
      "AGENTS.md": "allow",
      "~/.config/opencode/**": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.key": "deny",
      "*.pem": "deny",
      "*.p12": "deny",
      "*.pfx": "deny",
      "*.secret": "deny",
      "*secret*": "deny",
      "*token*": "deny",
      "*credential*": "deny",
      "*password*": "deny",
      "credentials/**": "deny",
      "*/credentials/**": "deny",
      "*/.ssh/**": "deny",
      "*/secrets/**": "deny"
    },
    "interactive_bash": "ask",
    "mise_*": "ask",
    "external_directory": {
      "*": "ask",
      "/tmp/**": "allow",
      "~/.config/opencode/**": "allow",
      "~/.agents/skills/**": "allow",
      "~/.cache/oh-my-opencode/**": "allow",
      "~/.cache/oh-my-openagent/**": "allow",
      "~/.cache/opencode/**": "allow",
      "/tmp/opencode/**": "allow"
    }
  },
  "formatter": {
    "gofmt": {
      "command": [
        "gofmt",
        "-w",
        "$FILE"
      ],
      "extensions": [
        ".go"
      ]
    },
    "shfmt": {
      "command": [
        "shfmt",
        "-w",
        "$FILE"
      ],
      "extensions": [
        ".sh",
        ".bash"
      ]
    },
    "prettier": {
      "command": [
        "npx",
        "prettier",
        "--write",
        "$FILE"
      ],
      "extensions": [
        ".yaml",
        ".yml",
        ".md"
      ]
    }
  }
}
