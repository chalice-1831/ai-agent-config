# Shell command policy.
prefix_rule(pattern = ["ls"], decision = "allow", match = ["ls --help"])
prefix_rule(pattern = ["find"], decision = "allow", match = ["find --help"])
prefix_rule(pattern = ["rg"], decision = "allow", match = ["rg --help"])
prefix_rule(pattern = ["grep"], decision = "allow", match = ["grep --help"])
prefix_rule(pattern = ["sed"], decision = "allow", match = ["sed --help"])
prefix_rule(pattern = ["cat"], decision = "allow", match = ["cat --help"])
prefix_rule(pattern = ["head"], decision = "allow", match = ["head --help"])
prefix_rule(pattern = ["tail"], decision = "allow", match = ["tail --help"])
prefix_rule(pattern = ["wc"], decision = "allow", match = ["wc --help"])
prefix_rule(pattern = ["sort"], decision = "allow", match = ["sort --help"])
prefix_rule(pattern = ["diff"], decision = "allow", match = ["diff --help"])
prefix_rule(pattern = ["jq"], decision = "allow", match = ["jq --help"])
prefix_rule(pattern = ["yq"], decision = "allow", match = ["yq --help"])
prefix_rule(pattern = ["echo"], decision = "allow", match = ["echo --help"])
prefix_rule(pattern = ["curl"], decision = "allow", match = ["curl --help"])
prefix_rule(pattern = ["dpkg"], decision = "allow", match = ["dpkg --help"])
prefix_rule(pattern = ["tmux"], decision = "allow", match = ["tmux --help"])
prefix_rule(pattern = ["xargs"], decision = "allow", match = ["xargs --help"])
prefix_rule(pattern = ["test"], decision = "allow", match = ["test --help"])
prefix_rule(pattern = ["awk"], decision = "allow", match = ["awk --help"])
prefix_rule(pattern = ["command", "-v"], decision = "allow", match = ["command -v --help"])
prefix_rule(pattern = ["pwd"], decision = "allow", match = ["pwd", "pwd --help"])
prefix_rule(pattern = ["which"], decision = "allow", match = ["which", "which --help"])
prefix_rule(pattern = ["true"], decision = "allow", match = ["true", "true --help"])
prefix_rule(pattern = ["base64", "-d"], decision = "allow", match = ["base64 -d", "base64 -d --help"])
prefix_rule(pattern = ["nl", "-ba"], decision = "allow", match = ["nl -ba", "nl -ba --help"])
prefix_rule(pattern = ["bash", "-n"], decision = "allow", match = ["bash -n script.sh"], not_match = ["bash -c 'echo example'"])
