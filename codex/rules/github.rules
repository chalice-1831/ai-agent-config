# Github command policy.
prefix_rule(pattern = ["gh", "help"], decision = "allow", match = ["gh help --help"])
prefix_rule(pattern = ["gh", "status"], decision = "allow", match = ["gh status --help"])
prefix_rule(pattern = ["gh", "search", "code"], decision = "allow", match = ["gh search code --help"])
prefix_rule(pattern = ["gh", "search", "commits"], decision = "allow", match = ["gh search commits --help"])
prefix_rule(pattern = ["gh", "search", "issues"], decision = "allow", match = ["gh search issues --help"])
prefix_rule(pattern = ["gh", "search", "prs"], decision = "allow", match = ["gh search prs --help"])
prefix_rule(pattern = ["gh", "search", "repos"], decision = "allow", match = ["gh search repos --help"])
prefix_rule(pattern = ["gh", "repo", "view"], decision = "allow", match = ["gh repo view --help"])
prefix_rule(pattern = ["gh", "repo", "list"], decision = "allow", match = ["gh repo list --help"])
prefix_rule(pattern = ["gh", "repo", "ls"], decision = "allow", match = ["gh repo ls --help"])
prefix_rule(pattern = ["gh", "repo", "gitignore", "list"], decision = "allow", match = ["gh repo gitignore list --help"])
prefix_rule(pattern = ["gh", "repo", "gitignore", "view"], decision = "allow", match = ["gh repo gitignore view --help"])
prefix_rule(pattern = ["gh", "repo", "license", "list"], decision = "allow", match = ["gh repo license list --help"])
prefix_rule(pattern = ["gh", "repo", "license", "view"], decision = "allow", match = ["gh repo license view --help"])
prefix_rule(pattern = ["gh", "repo", "autolink", "list"], decision = "allow", match = ["gh repo autolink list --help"])
prefix_rule(pattern = ["gh", "repo", "autolink", "view"], decision = "allow", match = ["gh repo autolink view --help"])
prefix_rule(pattern = ["gh", "repo", "deploy-key", "list"], decision = "allow", match = ["gh repo deploy-key list --help"])
prefix_rule(pattern = ["gh", "repo", "read-dir"], decision = "allow", match = ["gh repo read-dir --help"])
prefix_rule(pattern = ["gh", "pr", "view"], decision = "allow", match = ["gh pr view --help"])
prefix_rule(pattern = ["gh", "pr", "list"], decision = "allow", match = ["gh pr list --help"])
prefix_rule(pattern = ["gh", "pr", "ls"], decision = "allow", match = ["gh pr ls --help"])
prefix_rule(pattern = ["gh", "pr", "diff"], decision = "allow", match = ["gh pr diff --help"])
prefix_rule(pattern = ["gh", "pr", "status"], decision = "allow", match = ["gh pr status --help"])
prefix_rule(pattern = ["gh", "pr", "checks"], decision = "allow", match = ["gh pr checks --help"])
prefix_rule(pattern = ["gh", "issue", "create"], decision = "allow", match = ["gh issue create --help"])
prefix_rule(pattern = ["gh", "issue", "edit"], decision = "allow", match = ["gh issue edit --help"])
prefix_rule(pattern = ["gh", "issue", "view"], decision = "allow", match = ["gh issue view --help"])
prefix_rule(pattern = ["gh", "issue", "list"], decision = "allow", match = ["gh issue list --help"])
prefix_rule(pattern = ["gh", "issue", "status"], decision = "allow", match = ["gh issue status --help"])
prefix_rule(pattern = ["gh", "issue", "comment"], decision = "allow", match = ["gh issue comment --help"])
prefix_rule(pattern = ["gh", "discussion", "view"], decision = "allow", match = ["gh discussion view --help"])
prefix_rule(pattern = ["gh", "discussion", "list"], decision = "allow", match = ["gh discussion list --help"])
prefix_rule(pattern = ["gh", "release", "view"], decision = "allow", match = ["gh release view --help"])
prefix_rule(pattern = ["gh", "release", "list"], decision = "allow", match = ["gh release list --help"])
prefix_rule(pattern = ["gh", "release", "ls"], decision = "allow", match = ["gh release ls --help"])
prefix_rule(pattern = ["gh", "release", "verify"], decision = "allow", match = ["gh release verify --help"])
prefix_rule(pattern = ["gh", "release", "verify-asset"], decision = "allow", match = ["gh release verify-asset --help"])
prefix_rule(pattern = ["gh", "run", "view"], decision = "allow", match = ["gh run view --help"])
prefix_rule(pattern = ["gh", "run", "list"], decision = "allow", match = ["gh run list --help"])
prefix_rule(pattern = ["gh", "run", "ls"], decision = "allow", match = ["gh run ls --help"])
prefix_rule(pattern = ["gh", "workflow", "view"], decision = "allow", match = ["gh workflow view --help"])
prefix_rule(pattern = ["gh", "workflow", "list"], decision = "allow", match = ["gh workflow list --help"])
prefix_rule(pattern = ["gh", "workflow", "ls"], decision = "allow", match = ["gh workflow ls --help"])
prefix_rule(pattern = ["gh", "label", "list"], decision = "allow", match = ["gh label list --help"])
prefix_rule(pattern = ["gh", "alias", "list"], decision = "allow", match = ["gh alias list --help"])
prefix_rule(pattern = ["gh", "skill", "list"], decision = "allow", match = ["gh skill list --help"])
prefix_rule(pattern = ["gh", "skill", "search"], decision = "allow", match = ["gh skill search --help"])
prefix_rule(pattern = ["gh", "skill", "preview"], decision = "allow", match = ["gh skill preview --help"])
prefix_rule(pattern = ["gh", "project", "list"], decision = "allow", match = ["gh project list --help"])
prefix_rule(pattern = ["gh", "project", "view"], decision = "allow", match = ["gh project view --help"])
prefix_rule(pattern = ["gh", "project", "field-list"], decision = "allow", match = ["gh project field-list --help"])
prefix_rule(pattern = ["gh", "project", "item-list"], decision = "allow", match = ["gh project item-list --help"])
prefix_rule(pattern = ["gh", "org", "list"], decision = "allow", match = ["gh org list --help"])
prefix_rule(pattern = ["gh", "ruleset", "check"], decision = "allow", match = ["gh ruleset check --help"])
prefix_rule(pattern = ["gh", "ruleset", "list"], decision = "allow", match = ["gh ruleset list --help"])
prefix_rule(pattern = ["gh", "ruleset", "view"], decision = "allow", match = ["gh ruleset view --help"])
prefix_rule(pattern = ["gh", "cache", "list"], decision = "allow", match = ["gh cache list --help"])
prefix_rule(pattern = ["gh", "agent-task", "list"], decision = "allow", match = ["gh agent-task list --help"])
prefix_rule(pattern = ["gh", "agent-task", "view"], decision = "allow", match = ["gh agent-task view --help"])
prefix_rule(pattern = ["gh", "gist", "list"], decision = "allow", match = ["gh gist list --help"])
prefix_rule(pattern = ["gh", "variable", "list"], decision = "allow", match = ["gh variable list --help"])
prefix_rule(pattern = ["gh", "--version"], decision = "allow", match = ["gh --version", "gh --version --help"])
prefix_rule(pattern = ["gh", "-h"], decision = "allow", match = ["gh -h", "gh -h --help"])
prefix_rule(pattern = ["gh", "--help"], decision = "allow", match = ["gh --help", "gh --help --help"])
prefix_rule(pattern = ["gh", "ssh-key", "list"], decision = "allow", match = ["gh ssh-key list", "gh ssh-key list --help"])
prefix_rule(pattern = ["gh", "gpg-key", "list"], decision = "allow", match = ["gh gpg-key list", "gh gpg-key list --help"])
prefix_rule(pattern = ["gh", "pr", "create"], decision = "allow", match = ["gh pr create --help"], not_match = ["gh pr merge 123", "gh pr close 123", "gh api repos/owner/repo/pulls/123"])
prefix_rule(pattern = ["gh", "pr", "edit"], decision = "allow", match = ["gh pr edit --help"], not_match = ["gh pr merge 123", "gh pr close 123", "gh api repos/owner/repo/pulls/123"])
prefix_rule(pattern = ["gh", "pr", "ready"], decision = "allow", match = ["gh pr ready --help"], not_match = ["gh pr merge 123", "gh pr close 123", "gh api repos/owner/repo/pulls/123"])
