# Infrastructure command policy.
prefix_rule(pattern = ["kubectl", "get"], decision = "allow", match = ["kubectl get --help"])
prefix_rule(pattern = ["kubectl", "describe"], decision = "allow", match = ["kubectl describe --help"])
prefix_rule(pattern = ["kubectl", "logs"], decision = "allow", match = ["kubectl logs --help"])
prefix_rule(pattern = ["docker", "ps"], decision = "allow", match = ["docker ps --help"])
prefix_rule(pattern = ["docker", "logs"], decision = "allow", match = ["docker logs --help"])
prefix_rule(pattern = ["docker", "images"], decision = "allow", match = ["docker images --help"])
prefix_rule(pattern = ["docker", "manifest", "inspect"], decision = "allow", match = ["docker manifest inspect --help"])
prefix_rule(pattern = ["docker", "build"], decision = "allow", match = ["docker build --help"])
prefix_rule(pattern = ["helm", "lint"], decision = "allow", match = ["helm lint --help"])
prefix_rule(pattern = ["helm", "version"], decision = "allow", match = ["helm version --help"])
prefix_rule(pattern = ["helm", "template"], decision = "allow", match = ["helm template --help"])
prefix_rule(pattern = ["helm", "dependency", "build"], decision = "allow", match = ["helm dependency build --help"])
prefix_rule(pattern = ["ansible-playbook", "--syntax-check"], decision = "allow", match = ["ansible-playbook --syntax-check --help"])
