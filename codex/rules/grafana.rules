# Grafana command policy.
prefix_rule(pattern = ["gcx", "help"], decision = "allow", match = ["gcx help --help"])
prefix_rule(pattern = ["gcx", "help-tree"], decision = "allow", match = ["gcx help-tree --help"])
prefix_rule(pattern = ["gcx", "commands"], decision = "allow", match = ["gcx commands --help"])
prefix_rule(pattern = ["gcx", "version"], decision = "allow", match = ["gcx version --help"])
prefix_rule(pattern = ["gcx", "providers", "list"], decision = "allow", match = ["gcx providers list --help"])
prefix_rule(pattern = ["gcx", "config", "list-contexts"], decision = "allow", match = ["gcx config list-contexts --help"])
prefix_rule(pattern = ["gcx", "config", "path"], decision = "allow", match = ["gcx config path --help"])
prefix_rule(pattern = ["gcx", "resources", "get"], decision = "allow", match = ["gcx resources get --help"])
prefix_rule(pattern = ["gcx", "resources", "list-types"], decision = "allow", match = ["gcx resources list-types --help"])
prefix_rule(pattern = ["gcx", "resources", "list-examples"], decision = "allow", match = ["gcx resources list-examples --help"])
prefix_rule(pattern = ["gcx", "resources", "validate"], decision = "allow", match = ["gcx resources validate --help"])
prefix_rule(pattern = ["gcx", "dashboards", "list"], decision = "allow", match = ["gcx dashboards list --help"])
prefix_rule(pattern = ["gcx", "dashboards", "search"], decision = "allow", match = ["gcx dashboards search --help"])
prefix_rule(pattern = ["gcx", "dashboards", "get"], decision = "allow", match = ["gcx dashboards get --help"])
prefix_rule(pattern = ["gcx", "dashboards", "list-versions"], decision = "allow", match = ["gcx dashboards list-versions --help"])
prefix_rule(pattern = ["gcx", "datasources", "list"], decision = "allow", match = ["gcx datasources list --help"])
prefix_rule(pattern = ["gcx", "datasources", "get"], decision = "allow", match = ["gcx datasources get --help"])
prefix_rule(pattern = ["gcx", "datasources", "health"], decision = "allow", match = ["gcx datasources health --help"])
prefix_rule(pattern = ["gcx", "datasources", "schemas"], decision = "allow", match = ["gcx datasources schemas --help"])
prefix_rule(pattern = ["gcx", "metrics", "labels"], decision = "allow", match = ["gcx metrics labels --help"])
prefix_rule(pattern = ["gcx", "metrics", "metadata"], decision = "allow", match = ["gcx metrics metadata --help"])
prefix_rule(pattern = ["gcx", "metrics", "series"], decision = "allow", match = ["gcx metrics series --help"])
prefix_rule(pattern = ["gcx", "metrics", "query"], decision = "allow", match = ["gcx metrics query --help"])
prefix_rule(pattern = ["gcx", "logs", "labels"], decision = "allow", match = ["gcx logs labels --help"])
prefix_rule(pattern = ["gcx", "logs", "series"], decision = "allow", match = ["gcx logs series --help"])
prefix_rule(pattern = ["gcx", "logs", "query"], decision = "allow", match = ["gcx logs query --help"])
prefix_rule(pattern = ["gcx", "logs", "metrics"], decision = "allow", match = ["gcx logs metrics --help"])
prefix_rule(pattern = ["gcx", "traces", "labels"], decision = "allow", match = ["gcx traces labels --help"])
prefix_rule(pattern = ["gcx", "traces", "query"], decision = "allow", match = ["gcx traces query --help"])
prefix_rule(pattern = ["gcx", "traces", "get"], decision = "allow", match = ["gcx traces get --help"])
prefix_rule(pattern = ["gcx", "traces", "metrics"], decision = "allow", match = ["gcx traces metrics --help"])
prefix_rule(pattern = ["gcx", "profiles", "labels"], decision = "allow", match = ["gcx profiles labels --help"])
prefix_rule(pattern = ["gcx", "profiles", "list-profile-types"], decision = "allow", match = ["gcx profiles list-profile-types --help"])
prefix_rule(pattern = ["gcx", "profiles", "query"], decision = "allow", match = ["gcx profiles query --help"])
prefix_rule(pattern = ["gcx", "profiles", "metrics"], decision = "allow", match = ["gcx profiles metrics --help"])
prefix_rule(pattern = ["gcx", "profiles", "exemplars"], decision = "allow", match = ["gcx profiles exemplars --help"])
prefix_rule(pattern = ["gcx", "--help"], decision = "allow", match = ["gcx --help", "gcx --help --help"])
prefix_rule(pattern = ["gcx", "config", "check"], decision = "allow", match = ["gcx config check", "gcx config check --help"])
prefix_rule(pattern = ["gcx", "config", "current-context"], decision = "allow", match = ["gcx config current-context", "gcx config current-context --help"])
