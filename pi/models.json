{
  "$schema": "https://pi.dev/schemas/models.schema.json",
  "providers": {
    "anthropic": {
      "baseUrl": "${ANTHROPIC_BASE_URL}",
      "api": "anthropic-messages",
      "apiKey": "${ANTHROPIC_AUTH_TOKEN}",
      "models": [
        { "id": "opus-5-5", "reasoning": true, "input": ["text", "image"], "contextWindow": 200000, "maxTokens": 128000 },
        { "id": "sonnet-5-5", "reasoning": true, "input": ["text", "image"], "contextWindow": 200000, "maxTokens": 128000 },
        { "id": "haiku-5-5", "reasoning": true, "input": ["text", "image"], "contextWindow": 200000, "maxTokens": 128000 }
      ]
    },
    "openai": {
      "baseUrl": "${OPENAI_BASE_URL}",
      "api": "openai-responses",
      "apiKey": "${OPENAI_AUTH_TOKEN}",
      "compat": { "supportsMaxOutputTokens": false },
      "models": [
        {
          "id": "astra-6",
          "reasoning": true,
          "thinkingLevelMap": { "low": "low", "medium": "medium", "high": "high", "xhigh": "xhigh" },
          "input": ["text", "image"],
          "contextWindow": 200000,
          "maxTokens": 128000
        },
        {
          "id": "sol-6.1",
          "reasoning": true,
          "thinkingLevelMap": { "low": "low", "medium": "medium", "high": "high", "xhigh": "xhigh" },
          "input": ["text", "image"],
          "contextWindow": 272000,
          "maxTokens": 128000,
          "cost": { "input": 2, "output": 10, "cacheRead": 0.1, "cacheWrite": 2.5 }
        },
        {
          "id": "luna-6",
          "reasoning": true,
          "thinkingLevelMap": { "low": "low", "medium": "medium", "high": "high", "xhigh": "xhigh" },
          "input": ["text", "image"],
          "contextWindow": 200000,
          "maxTokens": 128000
        }
      ]
    }
  }
}
